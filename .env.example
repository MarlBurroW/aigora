# Provider API keys — at least one required for the backend to do anything.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional — Grok models via the native xAI API.
XAI_API_KEY=

# Optional — long-tail open-source models (Mistral, Llama, DeepSeek, Qwen,
# Cohere, etc.) via the OpenRouter gateway.
OPENROUTER_API_KEY=

# Local docker-compose Postgres. In Kubernetes this is set per-pod via the
# aigora-postgres Secret.
DATABASE_URL=postgresql://politix:politix_local_dev@localhost:5432/politix
